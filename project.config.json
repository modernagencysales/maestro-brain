{
  "project": {
    "name": "maestro-template"
  },
  "sharedConvexBackendNote": "The template showcase intentionally points staging and production Pages deployments at the same read-only seeded Convex demo backend. Client forks with tenant data must replace this with separate staging and production Convex deployments before claiming backend promotion isolation.",
  "environments": {
    "staging": {
      "name": "staging",
      "domain": "maestro-template-staging.pages.dev",
      "cloudflarePagesProject": "maestro-template-staging",
      "cloudflareBranch": "staging",
      "convexDeployName": "maestro-template-staging",
      "convexUrl": "https://exciting-cat-536.convex.cloud",
      "requiredEnvGroups": [
        "cloudflare",
        "convex",
        "buildkite",
        "fake-providers"
      ],
      "requiredSecrets": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "CONVEX_DEPLOY_KEY"
      ]
    },
    "production": {
      "name": "production",
      "domain": "maestro-template.pages.dev",
      "cloudflarePagesProject": "maestro-template",
      "cloudflareBranch": "main",
      "convexDeployName": "maestro-template-production",
      "convexUrl": "https://exciting-cat-536.convex.cloud",
      "requiredEnvGroups": [
        "cloudflare",
        "convex",
        "buildkite",
        "workos",
        "posthog",
        "dodo",
        "mailersend",
        "llm",
        "storage"
      ],
      "requiredSecrets": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "CONVEX_DEPLOY_KEY"
      ]
    }
  }
}
