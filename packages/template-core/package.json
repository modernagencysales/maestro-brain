{
  "name": "@maestro-template/template-core",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./generated/confectManifest": {
      "types": "./src/generated/confectManifest.ts",
      "default": "./src/generated/confectManifest.ts"
    },
    "./sha256": {
      "types": "./src/sha256.ts",
      "default": "./src/sha256.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir dist --declaration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}
