    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "convex": "1.42.1",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^4.1.1",
    "knip": "^6.23.0",
    "lefthook": "1.10.5",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
