    "verify": "pnpm check:format && pnpm lint && pnpm typecheck && pnpm check:effect-diagnostics && pnpm test:verify-uncovered && pnpm build && pnpm check:ci-completeness && pnpm check:config-drift && pnpm check:convex-ai-files && pnpm check:agent-pack && pnpm check:deps && pnpm check:knip && pnpm check:route-tree && pnpm check:frontend-effect-boundary && pnpm check:env-boundary && pnpm check:provider-boundary && pnpm check:logging-boundary && pnpm check:access-audit-events && pnpm check:coverage-ratchet && pnpm check:types-coverage && pnpm check:gates && pnpm check:debt && pnpm check:generators && pnpm check:recipes && pnpm check:docs-freshness && pnpm check:generated-files && pnpm check:confect-effect-compat && pnpm check:confect-contracts && pnpm check:confect-compat && pnpm check:effectified-api-proof && pnpm check:workflow-semantics && pnpm check:workflow-graph-boundary && pnpm check:schema-migration-notes && pnpm check:system-catalog && pnpm check:system-topology && pnpm check:data-resources && pnpm check:append-only-tables && pnpm check:promotion-boundary && pnpm check:layer-boundaries && pnpm check:secret-canaries && pnpm check:sbom-license && pnpm check:confect-manifest && pnpm check:headless-surface-contract && pnpm check:posthog-readiness && pnpm check:auth-demo-bypass && pnpm check:saas-ui-foundation && pnpm check:saas-ui-artifact-safety && pnpm check:app-map && pnpm check:product-contract && pnpm acceptance:required",
    "coverage:update-baseline": "tsx tooling/quality/run-customer-coverage.mts --update",
    "prepare": "node tooling/quality/install-lefthook-if-git.mjs",
    "convex:codegen": "convex codegen",
    "convex:ai-files:install": "convex ai-files install",
    "convex:ai-files:status": "convex ai-files status",
    "check:convex-ai-files": "tsx tooling/quality/check-convex-ai-files.mts",
    "check:agent-pack": "tsx tooling/quality/check-agent-pack.mts",
    "check:app-map": "pnpm --dir tooling/app-map check",
    "maestro:crud-proof": "tsx tooling/generators/src/crud-proof.ts --mode fake",
    "template:smoke": "tsx tooling/generators/src/customer-cli.ts smoke"
  },
