    "template:add-table": "tsx tooling/generators/src/customer-cli.ts add-table",
    "template:add-workflow": "tsx tooling/generators/src/customer-cli.ts add-workflow",
    "template:bump-workflow": "tsx tooling/generators/src/customer-cli.ts bump-workflow",
