digraph BrainSalvageS04T02 {
  graph [
    goal="Preserve and commit the pinned dirty S04-T02 repair",
    inputs="control_dir,workdir,evidence_dir,task_id,base_sha,expected_head,allowed_dirty_files,host_test_max_load_1m",
    model_stylesheet="
      #implement { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
    ",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]

  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; CONTROL='{{ inputs.control_dir|default('__required_control__') }}'; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; E='{{ inputs.evidence_dir|default('__required_evidence__') }}'; TASK='{{ inputs.task_id|default('__required_task__') }}'; EXPECTED='{{ inputs.expected_head|default('__required_head__') }}'; ALLOWED='{{ inputs.allowed_dirty_files|default('__required_dirty_files__') }}'; rtk proxy test \"$TASK\" = S04-T02; rtk proxy test \"${CONTROL#/}\" != \"$CONTROL\"; rtk proxy test \"${WORKDIR#/}\" != \"$WORKDIR\"; rtk proxy test \"${E#/}\" != \"$E\"; cd \"$WORKDIR\"; rtk proxy test \"$(rtk proxy git rev-parse HEAD)\" = \"$EXPECTED\"; STATUS=$(rtk proxy git status --porcelain=v1); rtk proxy test -n \"$STATUS\"; ACTUAL=$(rtk proxy git status --porcelain=v1 | rtk proxy sed 's/^...//' | rtk proxy sort | rtk proxy paste -sd, -); rtk proxy test \"$ACTUAL\" = \"$ALLOWED\"; MANIFEST=\"$CONTROL/docs/superpowers/execution/maestro-brain/task-manifest.json\"; rtk proxy test -s \"$MANIFEST\"; rtk proxy node -e \"const fs=require('fs'); const m=JSON.parse(fs.readFileSync(process.argv[1],'utf8')); const t=m.tasks.find((x)=>x.taskId===process.argv[2]); if(!t) throw new Error('task missing'); if(t.sourceSliceLimit !== 5) throw new Error('sourceSliceLimit !== 5'); const allowed=process.argv[3].split(','); if(allowed.some((p)=>!t.fileLocks.includes(p))) throw new Error('dirty file outside task locks')\" \"$MANIFEST\" \"$TASK\" \"$ALLOWED\"; rtk proxy mkdir -p \"$E/lane-results/$TASK\""]

  implement [label="Fabro-Owned Dirty Repair Salvage", max_visits=4, timeout="10800s", prompt="Salvage only task S04-T02 in {{ inputs.workdir|default('__required_workdir__') }}. The existing dirty repair was authored by Fabro and already passed focused Slack-directory tests and Convex typecheck. You own its preservation and product commits; the operator must not commit product code. Read the exact root AGENTS.md, the S04-T02 packet and current manifest entry under {{ inputs.control_dir|default('__required_control__') }}, then confirm HEAD {{ inputs.expected_head|default('__required_head__') }} and exact dirty allowlist {{ inputs.allowed_dirty_files|default('__required_dirty_files__') }}. Do not clean, reset away, drop, omit, or semantically alter the dirty repair. Do not edit the control checkout or sibling worktrees. Rebase the complete task plus dirty repair onto exact control base {{ inputs.base_sha|default('__required_base__') }} and rewrite only the S04-T02 task history into exactly five coherent intention commits, each at most 300 gate-counted hand-authored source lines. Before rewriting, record the complete target tree and after rewriting require the final tree to be identical. Every commit must contain real reviewable content. Never use --allow-empty. Never use git add .; stage exact manifest-owned paths or hunks. Use these five intentions: contracts/tables; pure plans/types; core read/identity/revocation helpers; commit mutation wiring; action/tests/docs/audit repair. Require exactly five commits after the base, exact manifest-owned changed paths, and a clean worktree. Preserve the existing focusedCommands. Rewrite only {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/S04-T02/ci-proof-packet.json with current planSha256/taskBlockHash, exact base/head/changedFiles/testsAdded, reviewVerdict pending, empty reviewFindings, and knownRisks. Do not write lane-result.json or claim independent review. Do not invoke lane-gates. Do not use native apply_patch; use guarded shell or write_file operations and raw rtk proxy git for machine evidence."]

  verify [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="5400s", script="set -euo pipefail; export HOST_TEST_MAX_LOAD_1M='{{ inputs.host_test_max_load_1m|default('20') }}'; CONTROL='{{ inputs.control_dir|default('__required_control__') }}'; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; E='{{ inputs.evidence_dir|default('__required_evidence__') }}'; BASE='{{ inputs.base_sha|default('__required_base__') }}'; EXPECTED='{{ inputs.expected_head|default('__required_head__') }}'; cd \"$WORKDIR\"; STATUS=$(rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\"; HEAD_SHA=$(rtk proxy git rev-parse HEAD); rtk proxy test \"$HEAD_SHA\" != \"$EXPECTED\"; rtk proxy test \"$(rtk proxy git rev-list --count \"$BASE..HEAD\")\" = 5; rtk host-test-slot --class focused pnpm --dir packages/convex test slack-directory; rtk host-test-slot --class focused pnpm --dir packages/convex typecheck; PROOF=\"$E/lane-results/S04-T02/ci-proof-packet.json\"; rtk proxy test -s \"$PROOF\"; rtk proxy node -e \"const fs=require('fs'); const p=JSON.parse(fs.readFileSync(process.argv[1],'utf8')); const m=JSON.parse(fs.readFileSync(process.argv[2],'utf8')); const t=m.tasks.find((x)=>x.taskId==='S04-T02'); if(p.taskId!=='S04-T02'||p.headSha!==process.argv[3]||p.baseSha!==process.argv[4]) throw new Error('proof identity mismatch'); if(p.taskBlockHash!==t.taskBlockHash) throw new Error('proof task hash mismatch'); if(p.reviewVerdict !== 'pending') throw new Error('reviewVerdict !== pending'); if((p.reviewFindings??[]).length!==0) throw new Error('salvage proof has findings')\" \"$PROOF\" \"$CONTROL/docs/superpowers/execution/maestro-brain/task-manifest.json\" \"$HEAD_SHA\" \"$BASE\""]

  start -> preflight
  preflight -> implement [condition="outcome=succeeded"]
  preflight -> exit [label="scope mismatch"]
  implement -> verify
  verify -> exit [condition="outcome=succeeded"]
  verify -> implement [label="red"]
}
