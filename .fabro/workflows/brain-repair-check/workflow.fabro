digraph BrainRepairCheck {
  graph [
    goal="Repair one exact Maestro Brain check at its owning task",
    inputs="workdir,evidence_dir,task_id,failing_command,failure_log",
    model_stylesheet="#repair { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; } #review { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]
  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; WORKDIR='{{ inputs.workdir|default('__required_workdir__') }}'; EVIDENCE='{{ inputs.evidence_dir|default('__required_evidence__') }}'; rtk proxy test \"${WORKDIR#/}\" != \"$WORKDIR\"; rtk proxy test \"${EVIDENCE#/}\" != \"$EVIDENCE\"; cd \"$WORKDIR\"; rtk proxy test -s docs/superpowers/execution/maestro-brain/task-manifest.json; rtk proxy test -n '{{ inputs.failing_command|default('__required_command__') }}'; rtk proxy test -s \"$EVIDENCE/lane-results/{{ inputs.task_id|default('__required_task__') }}/ci-proof-packet.json\""]
  repair [label="Repair Root Cause", max_visits=4, timeout="7200s", prompt="For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Repair only the root cause of failing command {{ inputs.failing_command|default('__required_command__') }} for owning task {{ inputs.task_id|default('__required_task__') }} in {{ inputs.workdir|default('__required_workdir__') }}. Before every mutating tool call, verify the target is under the exact repair workdir; never mutate the control checkout or a sibling worktree. The only allowed evidence write is {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/{{ inputs.task_id|default('__required_task__') }}/ci-proof-packet.json. Read that proof, its sibling lane-gate-report.json, the task packet, and failure log {{ inputs.failure_log|default('__required_failure_log__') }} by exact path. Reproduce first. Do not weaken gates, delete tests, add broad suppressions, or touch unrelated tasks. Add or strengthen a regression test, make the narrow fix, rerun the exact failure, amend the owning task commit when safe, and update its head-bound proof. After the first apply_patch expects raw patch text failure, stop using native apply_patch, switch to a targeted shell or write_file edit, and immediately inspect git diff."]
  pre_review_gate [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="5400s", script="set -euo pipefail; cd '{{ inputs.workdir|default('__required_workdir__') }}'; rtk proxy node --import tsx tooling/brain-factory/src/lane-gates.mts --task '{{ inputs.task_id|default('__required_task__') }}' --evidence '{{ inputs.evidence_dir|default('__required_evidence__') }}' --stage pre-review"]
  review [label="Independent Repair Review", max_visits=4, timeout="1800s", prompt="For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Never search the home directory, a repository parent, or a path outside the exact worktree and named evidence artifact. Perform a read-only review of the repair for {{ inputs.task_id|default('__required_task__') }} in {{ inputs.workdir|default('__required_workdir__') }}. Never edit or commit product/worktree files and never certify a repair authored in this review turn. The only allowed write is {{ inputs.evidence_dir|default('__required_evidence__') }}/lane-results/{{ inputs.task_id|default('__required_task__') }}/ci-proof-packet.json. Confirm the exact failure is fixed by a regression test, no gate or contract was weakened, and the diff remains inside ownership. Set reviewVerdict='rework' with stable-ID reviewFindings for any defect; only an independent clean review may set reviewVerdict='pass' bound to exact HEAD."]
  complete [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="300s", script="set -euo pipefail; cd '{{ inputs.workdir|default('__required_workdir__') }}'; TASK='{{ inputs.task_id|default('__required_task__') }}'; E='{{ inputs.evidence_dir|default('__required_evidence__') }}'; HEAD_SHA=$(rtk proxy git rev-parse HEAD); rtk proxy node -e \"const fs=require('fs'); const p=process.argv[1]; const taskId=process.argv[2]; const headSha=process.argv[3]; const manifest=JSON.parse(fs.readFileSync('docs/superpowers/execution/maestro-brain/task-manifest.json','utf8')); const task=manifest.tasks.find((candidate)=>candidate.taskId===taskId); if(!task || typeof task.tranche!=='string') throw new Error(taskId+': manifest tranche missing'); fs.writeFileSync(p, JSON.stringify({schemaVersion:'maestro-brain-lane-result/v1',taskId,headSha,tranche:task.tranche,status:'lane_green'},null,2)+'\\n')\" \"$E/lane-results/$TASK/lane-result.json\" \"$TASK\" \"$HEAD_SHA\""]
  final_gate [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="5400s", script="set -euo pipefail; cd '{{ inputs.workdir|default('__required_workdir__') }}'; rtk proxy node --import tsx tooling/brain-factory/src/lane-gates.mts --task '{{ inputs.task_id|default('__required_task__') }}' --evidence '{{ inputs.evidence_dir|default('__required_evidence__') }}' --stage final --reuse-pre-review"]
  start -> preflight
  preflight -> repair [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  repair -> pre_review_gate
  pre_review_gate -> review [condition="outcome=succeeded"]
  pre_review_gate -> repair [label="red"]
  review -> complete
  complete -> final_gate
  final_gate -> exit [condition="outcome=succeeded"]
  final_gate -> repair [label="red or rework"]
}
