digraph BrainRepairCheck {
  graph [
    goal="Repair one exact Maestro Brain check at its owning task",
    inputs="workdir,evidence_dir,task_id,failing_command,failure_log",
    model_stylesheet="#repair { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; } #review { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]
  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk proxy test -s docs/superpowers/execution/maestro-brain/task-manifest.json; rtk proxy test -n '{{ inputs.failing_command|default('missing') }}'"]
  repair [label="Repair Root Cause", max_visits=4, timeout="7200s", prompt="Repair only the root cause of failing command {{ inputs.failing_command|default('(missing)') }} for owning task {{ inputs.task_id|default('S01-T01') }} in {{ inputs.workdir|default('.') }}. Before every mutating tool call, verify the target is under the exact repair workdir; never mutate the control checkout or a sibling worktree. The only allowed write outside the repair workdir is this task's proof under the absolute evidence directory. Read the task packet, proof, gate report, and failure log {{ inputs.failure_log|default('(not provided)') }}. Reproduce first. Do not weaken gates, delete tests, add broad suppressions, or touch unrelated tasks. Add or strengthen a regression test, make the narrow fix, rerun the exact failure, amend the owning task commit when safe, and update its head-bound proof. If native apply_patch fails once, stop using it, switch to a targeted shell or write_file edit, and immediately inspect git diff."]
  gate [shape=parallelogram, goal_gate=true, retry_target=repair, timeout="5400s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk pnpm brain:factory:lane-gates -- --task '{{ inputs.task_id|default('S01-T01') }}' --evidence '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}' --stage final"]
  review [label="Repair Review", timeout="1800s", prompt="Review the repair for {{ inputs.task_id|default('S01-T01') }}. Mutate only the exact repair workdir and this task's proof under the absolute evidence directory; never touch the control checkout or sibling worktrees. Confirm the exact failure is fixed by a regression test, no gate or contract was weakened, and the diff remains inside ownership. If native apply_patch fails once, stop using it and use a targeted write_file or shell edit. Record PASS or a concrete blocker in the task evidence."]
  start -> preflight
  preflight -> repair [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  repair -> gate
  gate -> review [condition="outcome=succeeded"]
  gate -> repair [label="red"]
  review -> exit
}
