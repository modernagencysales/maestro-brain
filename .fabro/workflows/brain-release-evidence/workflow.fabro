digraph BrainReleaseEvidence {
  graph [
    goal="Prove one frozen Maestro Brain release candidate through staging, pilot, and rollback",
    inputs="workdir,evidence_dir,release_commit",
    model_stylesheet="#operate { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; } #review { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]
  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="1800s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk proxy test \"$(rtk git rev-parse HEAD)\" = '{{ inputs.release_commit|default('HEAD') }}'; rtk host-test-slot --class full pnpm verify; rtk pnpm deploy:doctor staging; rtk pnpm deploy:doctor production"]
  operate [label="Run Release Evidence", max_visits=2, timeout="604800s", prompt="For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Execute S14-T01 and Appendices K/L/N for frozen candidate {{ inputs.release_commit|default('HEAD') }}. Before every mutating tool call, verify the target is under the exact release workdir or the release subdirectory of the absolute evidence directory; never mutate the control checkout or any implementation worktree. Use only approved synthetic/pilot data and never record secrets or customer text. Stage the exact candidate, run migrations and hosted/provider/headless/lifecycle smokes, prove rollback without destructive reverse migration, then monitor at least five pilot agencies for at least seven days. Record exact hashes, commands, denominators, incidents, thresholds, owners, and verdict under {{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}/release/. If native apply_patch fails once, stop using it and use a targeted write_file or shell edit. Do not implement product fixes in this workflow: a material failure creates a scoped repair and a new candidate/pilot window."]
  review [label="Release Evidence Review", timeout="7200s", prompt="For file discovery, use scoped rtk rg --files <target-path> or exact targeted paths only; never use a repository-wide glob. When vendored reference is required, target only the named repos/<library>/<subpath>. Audit the release packet against S14-T01 and Appendices J-N. Mutate only the exact release workdir or release subdirectory of the absolute evidence directory; never touch the control checkout or implementation worktrees. Reject missing provider/CI context, inherited evidence without signed materiality, rounded-down pilot denominators, a shortened pilot, destructive rollback, or any zero-tolerance incident. If native apply_patch fails once, stop using it and use a targeted write_file or shell edit. Produce a binary go/no-go verdict and exact failed clause."]
  start -> preflight
  preflight -> operate [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  operate -> review -> exit
}
