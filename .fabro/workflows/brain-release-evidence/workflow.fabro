digraph BrainReleaseEvidence {
  graph [
    goal="Prove one frozen Maestro Brain release candidate through staging, pilot, and rollback",
    inputs="workdir,evidence_dir,release_commit",
    model_stylesheet="#operate { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; } #review { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]
  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="1800s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk proxy test \"$(rtk git rev-parse HEAD)\" = '{{ inputs.release_commit|default('HEAD') }}'; rtk host-test-slot --class full pnpm verify; rtk pnpm deploy:doctor staging; rtk pnpm deploy:doctor production"]
  operate [label="Run Release Evidence", max_visits=2, timeout="604800s", prompt="Execute S14-T01 and Appendices K/L/N for frozen candidate {{ inputs.release_commit|default('HEAD') }}. Use only approved synthetic/pilot data and never record secrets or customer text. Stage the exact candidate, run migrations and hosted/provider/headless/lifecycle smokes, prove rollback without destructive reverse migration, then monitor at least five pilot agencies for at least seven days. Record exact hashes, commands, denominators, incidents, thresholds, owners, and verdict under {{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}/release/. Do not implement product fixes in this workflow: a material failure creates a scoped repair and a new candidate/pilot window."]
  review [label="Release Evidence Review", timeout="7200s", prompt="Audit the release packet against S14-T01 and Appendices J-N. Reject missing provider/CI context, inherited evidence without signed materiality, rounded-down pilot denominators, a shortened pilot, destructive rollback, or any zero-tolerance incident. Produce a binary go/no-go verdict and exact failed clause."]
  start -> preflight -> operate -> review -> exit
}
