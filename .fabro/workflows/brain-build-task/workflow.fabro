digraph BrainBuildTask {
  graph [
    goal="Implement one approved Maestro Brain task with test-first focused proof",
    inputs="workdir,evidence_dir,task_id,base_sha,start_sha",
    model_stylesheet="
      #implement { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
      #review    { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
    ",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]

  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; TASK='{{ inputs.task_id|default('S01-T01') }}'; E='{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}'; EXPECTED='{{ inputs.start_sha|default('') }}'; rtk proxy test -n \"$EXPECTED\"; rtk proxy test -s docs/superpowers/execution/maestro-brain/task-manifest.json; rtk proxy test -s docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md; rtk proxy mkdir -p \"$E/lane-results/$TASK\"; STATUS=$(rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\"; rtk proxy test \"$(rtk git rev-parse HEAD)\" = \"$EXPECTED\""]

  implement [label="Implement Task", max_visits=5, timeout="10800s", prompt="Implement only task {{ inputs.task_id|default('S01-T01') }} in {{ inputs.workdir|default('.') }}. Read the root AGENTS.md by its exact path, the Parallel Execution Amendment and Appendices O/P, this task's complete packet in docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md, its entry in docs/superpowers/execution/maestro-brain/task-manifest.json, every named playbook/anchor required by its classification, and only directly relevant source or vendored examples. Never glob node_modules or the whole worktree to find instruction files. Do not repeat global product research. Before every edit or mutating shell command, verify the target is under the exact task workdir; never edit, reset, clean, remove, or otherwise mutate the control checkout or any sibling worktree. The only allowed write outside the task workdir is the named proof packet under the absolute evidence directory. Report accidental cross-worktree changes instead of cleaning them. Respect codeStartAfter as code-start authority and the original packet dependency as acceptance authority. If the branch already contains this task's implementation, review and repair it instead of duplicating it. Compare the complete task diff from {{ inputs.base_sha|default('HEAD') }}; when one task commit exceeds 300 changed hand-authored source lines, rewrite only the task's unintegrated history into two to four coherent intention commits, each within the slice budget. Edit only declared files or stop and amend the task contract. Never edit generated files unless this task owns @generated-confect. Use fake/local providers by default. Write the new behavior's focused tests before its implementation and preserve typed errors, tenant isolation, lifecycle fencing, redaction, and the repository layer law. Use repo generators exactly when the packet is pattern-instance. Do not weaken gates, add unexplained suppressions, or implement another task. Run every exact focused packet command except broad just verify/verify-full, then the relevant package-local lint/type/test commands. Broad verification belongs to tranche integration. Record focusedCommands as exact single-process commands beginning with rtk; do not record prose, output, shell chaining, quoting, or broad root test/typecheck/verify commands. Commit one to four coherent intentions with conventional subjects. Write ci-proof-packet.json to the absolute directory {{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}/lane-results/{{ inputs.task_id|default('S01-T01') }}/ with schemaVersion='maestro-brain-ci-proof/v1', planSha256 copied from the current task manifest, taskBlockHash copied from this task's current manifest entry, taskId, baseSha='{{ inputs.base_sha|default('HEAD') }}', headSha, changedFiles, focusedCommands, testsAdded, reviewVerdict='pending', and knownRisks. Never invent or preserve stale plan/task hashes: a changed contract requires a new proof and gates. The proof head may precede only a byte-identical Fabro checkpoint and the worktree must be clean. Do not use native apply_patch in this Fabro lane; use only guarded targeted shell or write_file edits and inspect git diff immediately after every edit."]

  gates [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="5400s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk pnpm brain:factory:lane-gates -- --task '{{ inputs.task_id|default('S01-T01') }}' --evidence '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}' --stage pre-review"]

  review [label="Independent Read-Only Contract Review", max_visits=2, timeout="5400s", prompt="Independently review task {{ inputs.task_id|default('S01-T01') }} in {{ inputs.workdir|default('.') }} against its full task packet, design requirements, task-manifest ownership, AGENTS.md, tests, and ci-proof-packet.json. Never edit, amend, or commit product/worktree files and never certify a repair authored in this review turn. The only allowed write is the named proof packet under the absolute evidence directory. Verify schemaVersion maestro-brain-ci-proof/v1 and exact current planSha256/taskBlockHash before reviewing; never repair stale contract identity during review. Inspect the actual committed diff. Look specifically for false-green tests, missing expected errors, cross-tenant access, stale-generation races, lifecycle resurrection, secret/customer-text exposure, layer skips, fixture leakage, generated-file drift, and scope beyond the task. On any defect or contract drift set reviewVerdict='rework' and add stable-ID reviewFindings; the final gate will route the task back to the implementation owner. Only when no defect remains set reviewVerdict='pass', bind it to exact HEAD, preserve the exact contract hashes, and leave reviewFindings empty. Run focused read-only checks only; do not run broad verify."]

  final_gates [shape=parallelogram, goal_gate=true, retry_target=implement, timeout="5400s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk pnpm brain:factory:lane-gates -- --task '{{ inputs.task_id|default('S01-T01') }}' --evidence '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}' --stage final --reuse-pre-review"]

  complete [shape=parallelogram, goal_gate=true, retry_target=complete, max_retries=1, timeout="300s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; TASK='{{ inputs.task_id|default('S01-T01') }}'; E='{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}'; HEAD_SHA=$(rtk git rev-parse HEAD); rtk proxy node -e \"const fs=require('fs'); const p=process.argv[1]; const taskId=process.argv[2]; const headSha=process.argv[3]; fs.writeFileSync(p, JSON.stringify({schemaVersion:'maestro-brain-lane-result/v1',taskId,headSha,status:'lane_green'},null,2)+'\\n')\" \"$E/lane-results/$TASK/lane-result.json\" \"$TASK\" \"$HEAD_SHA\""]

  start -> preflight
  preflight -> implement [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  implement -> gates
  gates -> review [condition="outcome=succeeded"]
  gates -> implement [label="red"]
  review -> final_gates
  final_gates -> complete [condition="outcome=succeeded"]
  final_gates -> implement [label="red"]
  complete -> exit
}
