digraph BrainIntegrateTranche {
  graph [
    goal="Integrate one dependency-safe Maestro Brain tranche and prove the combined head",
    inputs="workdir,evidence_dir,tranche,base_sha",
    model_stylesheet="
      #integrate { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
      #review    { provider: codex-lb; model: codex-lb-gpt-5.5; reasoning_effort: high; }
    ",
    rankdir=LR
  ]
  start [shape=Mdiamond]
  exit [shape=Msquare]
  preflight [shape=parallelogram, goal_gate=true, retry_target=preflight, max_retries=1, timeout="600s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk proxy test -s docs/superpowers/execution/maestro-brain/task-manifest.json; rtk proxy test -d '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}/lane-results'; rtk proxy mkdir -p '{{ inputs.evidence_dir|default('.fabro/state/maestro-brain/evidence') }}/integration/{{ inputs.tranche|default('C1-contract-spine') }}'"]
  integrate [label="Integrate Green Lanes", max_visits=4, timeout="10800s", prompt="Integrate tranche {{ inputs.tranche|default('C1-contract-spine') }} in {{ inputs.workdir|default('.') }}. Before every mutating tool call, verify the target is under the exact integration workdir; never edit, reset, clean, remove, or otherwise mutate the control checkout or a task worktree. The only allowed write outside the integration workdir is this tranche's result under the absolute evidence directory. Report accidental cross-worktree changes instead of cleaning them. Read the task manifest and only select this tranche's lane-result.json entries with status lane_green, matching final passed lane-gate-report.json, matching proof/head hashes, satisfied codeStartAfter dependencies already present on the base or this integration head, and nonconflicting ownership. Cherry-pick each one-intention task commit in deterministic topological/task-ID order. Reject drift or send a conflict back to the owning task; do not silently blend two owners. Run centralized Confect/Convex/route codegen at most once when the accepted tasks own it. Update subsystem status docs in the owning commit or add a narrow integration commit. Do not weaken tests or gates. Produce a draft integration-result.json under the absolute evidence integration directory with included tasks, commits, generated diffs, conflicts, and status ready_for_review. If native apply_patch fails once, stop using it, switch to a targeted shell or write_file edit, and immediately inspect git diff."]
  review [label="Cross-Domain Review", max_visits=2, timeout="5400s", prompt="Review the integrated tranche {{ inputs.tranche|default('C1-contract-spine') }} against every included task packet and proof. Before every mutating tool call, verify the target is under the exact integration workdir; never edit, reset, clean, remove, or otherwise mutate the control checkout or a task worktree. The only allowed write outside the integration workdir is this tranche's result under the absolute evidence directory. Report accidental cross-worktree changes instead of cleaning them. Check cross-lane contract compatibility, generated refs, tenant isolation, lifecycle monotonicity, provider boundaries, typed errors, test honesty, and shared-file ownership. Fix only integration defects, preserving one-intention task history. Update integration-result.json with reviewVerdict pass or rework. If native apply_patch fails once, stop using it, switch to a targeted shell or write_file edit, and immediately inspect git diff. Do not claim tasks accepted yet."]
  gates [shape=parallelogram, goal_gate=true, retry_target=integrate, timeout="10800s", script="set -euo pipefail; cd {{ inputs.workdir|default('.') }}; rtk host-test-slot --class full pnpm verify; rtk git diff --check; STATUS=$(rtk proxy git status --porcelain); rtk proxy test -z \"$STATUS\""]
  record [label="Record Integration", timeout="1800s", prompt="The full tranche gate passed for {{ inputs.tranche|default('C1-contract-spine') }}. Mutate only the exact integration workdir and the named tranche/task JSON files under the absolute evidence directory; never touch the control checkout or task worktrees. Update the absolute integration-result.json with the exact integrated head and status passed. For every included task, update its lane-result.json status to integrated and record tranche/head without changing its proof. Do not mark accepted unless its original acceptanceAfter condition is also present on this head; if it is, record accepted separately. If native apply_patch fails once, stop using it and use a targeted write_file or shell edit. Leave the integration worktree clean."]
  start -> preflight
  preflight -> integrate [condition="outcome=succeeded"]
  preflight -> exit [label="blocked"]
  integrate -> review -> gates
  gates -> record [condition="outcome=succeeded"]
  gates -> integrate [label="red"]
  record -> exit
}
