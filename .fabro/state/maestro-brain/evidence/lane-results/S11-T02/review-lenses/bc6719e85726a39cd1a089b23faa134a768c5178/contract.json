  "findings": [
    {
      "id": "CONTRACT-S11-T02-001",
      "severity": "major",
      "summary": "Public headless HTTP still exposes NotFound outside the declared external failure union.",
      "details": "S11-T02 declares uniform external errors as Unauthorized, Forbidden, ValidationFailed, or RateLimited. The headless executor and request helper now use that union, and RateLimited has an executable admission path, but the HTTP composition root still returns a NotFound envelope for unknown routes when the Authorization header is absent. That response is outside the declared external failure contract, so API/CLI/MCP consumers cannot rely on the S11-T02 uniform envelope for all public headless HTTP failures.",
      "evidence": [
        "docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md:3116-3119",
        "packages/convex/confect/http.ts:442-452",
