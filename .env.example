# Maestro Template local fake-mode environment.
# Copy to .env.local for local development. Do not put live secrets here.

APP_NAME=acme-demo
APP_PUBLIC_BASE_URL=https://acme-demo.example.test
APP_ENV=fake
APP_PROVIDER_MODE=fake

CONVEX_DEPLOYMENT=dev:acme-demo
# Leave blank for fake-safe local web mode. Set to the Convex deployment URL
# after `pnpm convex:dev` or a real deploy if you want live Confect hooks.
VITE_CONVEX_URL=
CONVEX_SITE_URL=https://acme-demo.example.test
# Required only by `maestro-template api call`; keep the real bearer key in
# local secret storage rather than this example file.
MAESTRO_BRAIN_API_KEY=

WORKOS_CLIENT_ID=client_fake_local_key
WORKOS_ORGANIZATION_ID=org_acme_demo
WORKOS_REDIRECT_URI=https://acme-demo.example.test/auth/callback
WORKOS_LOGOUT_URI=https://acme-demo.example.test
WORKOS_COOKIE_PASSWORD=fake_local_key_fake_local_key_fake_local_key
WORKOS_API_KEY=fake_local_key
WORKOS_AUTHKIT_ISSUER=https://api.workos.com
WORKOS_AUTHKIT_JWKS_URL=https://api.workos.com/sso/jwks/org_acme_demo

POSTHOG_PROJECT_TOKEN=phc_test_placeholder
POSTHOG_HOST=http://localhost

DODO_API_KEY=fake_local_key
DODO_WEBHOOK_SECRET=fake_local_key
DODO_ENVIRONMENT=test

MAILERSEND_API_KEY=fake_local_key
MAILERSEND_FROM_EMAIL=no-reply@acme-demo.example.test
MAILERSEND_FROM_NAME=Acme Demo
EMAIL_DISABLED=true

OPENROUTER_API_KEY=fake_local_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER_MODE=fake
LLM_DISABLED=false
LLM_DAILY_SPEND_LIMIT_CENTS=2500
LLM_DEFAULT_MODEL=fake/local-demo

STORAGE_PROVIDER=fake
STORAGE_BUCKET=acme-demo
STORAGE_PUBLIC_BASE_URL=https://storage.acme-demo.example.test
STORAGE_ACCESS_KEY_ID=fake_local_key
STORAGE_SECRET_ACCESS_KEY=fake_local_key

SEARCH_PROVIDER=fake
SEARCH_API_KEY=fake_local_key
SEARCH_INDEX_PREFIX=acme-demo

# Nango Connect for Slack. Fake placeholders keep local mode non-live; real
# Slack tokens stay in Nango and must never be copied into Maestro env.
NANGO_SECRET_KEY=fake_local_key
NANGO_CONNECT_INTEGRATION_ID=slack
NANGO_CONNECT_PUBLIC_KEY=fake_public_key

CLOUDFLARE_ACCOUNT_ID=fake_local_key
CLOUDFLARE_API_TOKEN=fake_local_key
CLOUDFLARE_PAGES_PROJECT=maestro-template
CLOUDFLARE_PAGES_BRANCH=main
TEMPLATE_HOSTED_URL=https://maestro-template.pages.dev

BUILDKITE_ORGANIZATION_SLUG=modernagencysales
BUILDKITE_PIPELINE_SLUG=maestro-template
BUILDKITE_API_TOKEN=fake_local_key
BUILDKITE_AGENT_TOKEN=fake_local_key

# Deployment isolation examples: CI provides real values through separate
# staging/production secrets. Keep these fake locally.
MAESTRO_BRAIN_STAGING_CONVEX_DEPLOY_KEY=fake_local_key
MAESTRO_BRAIN_STAGING_CLOUDFLARE_API_TOKEN=fake_local_key
MAESTRO_BRAIN_STAGING_CLOUDFLARE_ACCOUNT_ID=fake_local_key
MAESTRO_BRAIN_STAGING_CALLBACK_ORIGIN=https://maestro-template-staging.pages.dev
MAESTRO_BRAIN_PRODUCTION_CONVEX_DEPLOY_KEY=fake_local_key
MAESTRO_BRAIN_PRODUCTION_CLOUDFLARE_API_TOKEN=fake_local_key
MAESTRO_BRAIN_PRODUCTION_CLOUDFLARE_ACCOUNT_ID=fake_local_key
MAESTRO_BRAIN_PRODUCTION_CALLBACK_ORIGIN=https://maestro-template.pages.dev

# Release packet signing examples. Real signing secret must come from CI secret storage.
MAESTRO_BRAIN_RELEASE_SIGNER=local-release-bot
MAESTRO_BRAIN_RELEASE_SIGNING_KEY_ID=maestro-brain-release-local
MAESTRO_BRAIN_RELEASE_SIGNING_SECRET=fake_local_key
