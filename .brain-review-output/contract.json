  "findings": [
    {
      "id": "CONTRACT-S08-T04-001",
      "severity": "high",
      "summary": "Workflow acceptance path does not gather routed evidence or call the maintenance capability.",
      "details": "S08-T04 requires routed units to gather an immutable context pack and produce cited no-op/revision proposals. The workflow graph remains a source-to-Trust-Receipt scaffold, and its focused test proves no queries, mutations, actions, events, or capability registry entries are used, so the approved task packet's end-to-end maintenance route is not implemented.",
      "evidence": [
        "docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md:2480-2522",
        "packages/convex/confect/workflows/sourceToBrainMaintenance.graph.ts:3-28",
        "packages/convex/test/sourceToBrainMaintenance.workflow.test.ts:19-64"
      ]
    },
    {
      "id": "CONTRACT-S08-T04-002",
      "severity": "high",
      "summary": "maintainBrainPage public contract is still a fixture rather than the S08-T04 proposal API.",
      "details": "The generated spec declares only workspaceSlug/contextPackId inputs and the implementation ignores them, always returning proposal_fixture/proposed_noop with fixture_citation. Callers therefore cannot rely on the capability to return cited Brain revision/no-op proposals from an immutable context pack or to enforce the declared proposal contract.",
      "evidence": [
        "docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md:2483-2485",
        "packages/convex/confect/capabilities/maintainBrainPage.spec.ts:47-80",
        "packages/convex/confect/capabilities/maintainBrainPage.impl.ts:7-17"
      ]
    },
    {
      "id": "CONTRACT-S08-T04-003",
      "severity": "medium",
      "summary": "Pattern-instance generated workflow contract is inconsistent with the task-owned generated runner path.",
      "details": "The task packet and generator provenance include packages/convex/convex/workflowRunners/sourceToBrainMaintenance.ts as generated output, and generated docs still instruct codegen to make workflowRunners/sourceToBrainMaintenance:run exist. The final task delta does not add that owned runner path, leaving replay/codegen instructions and generated contract ownership out of sync.",
      "evidence": [
        "docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md:2486-2505",
        "docs/template/generated/provenance/add-workflow/sourceToBrainMaintenance.json:5-12",
        "docs/template/generated/workflows/sourceToBrainMaintenance.md:16-38",
        "git diff --name-status e28ceeb126083211cc7b2070c673b78e513d125b...HEAD"
      ]
    },
    {
      "id": "CONTRACT-S08-T04-004",
      "severity": "high",
      "summary": "Declared maintenance failure paths are not reachable through the typed workflow/capability contract.",
      "details": "Pure helper tests exercise several MaintenancePolicyError names, but the Confect capability implementation always succeeds and the workflow contract exposes only generic workflow errors. The declared maintenance errors are therefore not bound to the executable typed API path that callers use.",
      "evidence": [
        "docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md:2527-2532",
