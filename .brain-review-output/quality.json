        "apps/web/src/features/brain/brain-editor-pane.tsx:96-115",
        "packages/editor-react/src/BlockNoteSyncEditor.test.tsx:25-40",
        "packages/editor-react/src/BlockNoteSyncEditor.tsx:80-97"
      ]
    }
  ],
  "verdict": "rework"
