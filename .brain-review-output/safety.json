  "findings": [
    {
      "id": "SAFETY-S08-T03-001",
      "severity": "blocking",
      "summary": "Classification requests are not tenant-bound or server-gathered before routing.",
      "details": "The workflow start API accepts a caller-supplied ClassificationRequest containing arbitrary allowedTargets and source text, records only workspace ownership, and passes that request directly to the classifier. classifySourceUnit then authorizes only the generic system caller and validates the provided target allowlist, but never verifies that the source unit, target Brain keys, and workspace belong to the same organization. This permits a malformed internal caller or replay to classify/route against cross-tenant target descriptors instead of the task-required server-gathered immutable unit and pinned tenant allowlist.",
      "evidence": [
        "packages/convex/confect/workflowContracts/sourceClassification.spec.ts:38-43",
        "packages/convex/confect/workflowContracts/sourceClassification.impl.ts:90-111",
        "packages/convex/confect/capabilities/classifySourceUnit.impl.ts:12-16",
        "docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md:2440-2449"
      ]
    },
    {
      "id": "SAFETY-S08-T03-002",
      "severity": "blocking",
      "summary": "Admin review authorization trusts the approval payload instead of proving reviewer authority.",
      "details": "The approval contract takes reviewerPrincipalKey and reviewerRole from the event payload, but approveImpl only checks that the caller is a system/internal principal before sending the event. The review helper also trusts reviewerRole as already true. There is no workspace membership lookup, organization admin/owner proof, or audit authority check for the named reviewer, so the required org-admin review gate can be forged by any internal workflow caller that can invoke approve.",
      "evidence": [
        "packages/convex/confect/workflowContracts/sourceClassification.spec.ts:54-70",
        "packages/convex/confect/workflowContracts/sourceClassification.impl.ts:141-150",
        "packages/convex/confect/classification/review.ts:39-45",
        "docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md:2392-2394"
      ]
    },
    {
      "id": "SAFETY-S08-T03-003",
      "severity": "blocking",
      "summary": "Lifecycle, concurrency, and revision fences are defined but not carried through the workflow commit path.",
      "details": "The pure commit helper can reject stale policy/source/lifecycle/route/lease generations, but the workflow start request and run args include only sourceUnitRevisionKey, sourceUnitHash, messages, policyVersion, and allowedTargets. The graph then passes classifier output plus review directly to routes.commit, with no lifecycleGeneration, routeGeneration, leaseGeneration, or current authority snapshot. As wired, concurrent stale generations, tombstoned/revoked source units, and expired leases cannot be fenced at the actual commit path required by S08-T03.",
      "evidence": [
        "packages/convex/confect/workflowContracts/sourceClassification.spec.ts:38-43",
        "packages/convex/confect/workflowContracts/sourceClassification.impl.ts:45-51",
        "packages/convex/confect/classification/commit.ts:49-69",
        "docs/superpowers/plans/2026-07-14-maestro-brain-agency-context-os-implementation-plan.md:2448-2459"
      ]
    }
  ],
  "verdict": "rework"
