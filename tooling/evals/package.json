{
  "name": "@maestro-template/evals",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --outDir dist --declaration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "brain:eval": "tsx src/brain-eval-cli.ts eval",
    "brain:fixture-check": "tsx src/brain-eval-cli.ts fixture-check",
    "brain:capacity": "tsx src/brain-capacity-report.ts"
  }
}
