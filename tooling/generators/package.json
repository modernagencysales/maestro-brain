{
  "name": "@maestro-template/generators",
  "private": true,
  "type": "module",
  "main": "src/customer.ts",
  "types": "src/customer.ts",
  "exports": {
    ".": "./src/customer.ts"
  },
  "dependencies": {
    "@maestro-template/template-core": "workspace:*"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "scripts": {
    "cli": "tsx src/customer-cli.ts",
    "build": "tsc -p tsconfig.customer.json --outDir dist --declaration",
    "typecheck": "tsc -p tsconfig.customer.json --noEmit",
    "test": "vitest run --passWithNoTests --pool=threads --maxWorkers=1 --no-file-parallelism"
  }
}
